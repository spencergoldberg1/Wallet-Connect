<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/salesforce-lightning-design-system/2.15.4/styles/salesforce-lightning-design-system.min.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <title>Tron Wallet Connect Page</title>
    <style>
        body {
            background-color: #f0f4ff;
            font-family: 'Salesforce Sans', Arial, sans-serif;
        }
        .wallet-container {
            max-width: 600px;
            margin: 50px auto;
            padding: 30px;
            background-color: white;
            border-radius: 15px;
            box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
            text-align: center;
        }
        .wallet-button-container {
            display: flex;
            justify-content: center;
            margin-bottom: 20px;
        }
        .dropdown {
            width: 100%;
            padding: 10px;
            margin: 15px 0;
            border: 1px solid #ccc;
            border-radius: 10px;
        }
        .divider {
            margin: 30px 0;
            font-weight: bold;
            font-size: 1em;
            color: #6c757d;
        }
        .address-input-container {
            margin-bottom: 20px;
        }
        .wallet-input {
            padding: 10px;
            font-size: 1em;
            width: 100%;
            border: 1px solid #ccc;
            border-radius: 10px;
        }
        .connect-btn {
            padding: 10px 20px;
            font-size: 1em;
            color: white;
            background-color: #0070d2;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            transition: background-color 0.3s;
        }
        .connect-btn:hover {
            background-color: #005bb5;
        }
        .connect-btn:disabled, .submit-btn:disabled {
            background-color: #ccc;
            cursor: not-allowed;
        }
    </style>
</head>
<body>
    <div class="slds-grid slds-grid_vertical-align-center slds-grid_align-center">
        <div class="wallet-container slds-box slds-theme_default">
            <h2 class="slds-text-heading_medium">Connect Your Tron Wallet</h2>
            <p class="slds-text-body_regular">To proceed, please connect your wallet via one of the supported methods or manually enter your Tron address.</p>

            <label for="walletSelect">Choose your wallet:</label>
            <select id="walletSelect" class="dropdown">
                <option value="" disabled selected>Select a wallet</option>
                <option value="tronlink">TronLink</option>
                <option value="ledger">Ledger</option>
            </select>

            <div class="wallet-button-container">
                <button id="connectWalletButton" class="connect-btn" disabled>Connect</button>
            </div>

            <div class="divider">or</div>

            <form method="POST">
                <div class="address-input-container">
                    <input type="text" class="wallet-input" id="tronAddressInput" name="tronAddress" placeholder="Enter Tron wallet address">
                </div>

                <button type="submit" class="connect-btn" id="submitButton" disabled>Submit</button>
            </form>

            <p id="walletStatus" class="status">Please select a wallet to connect.</p>
        </div>
    </div>

    <script src="/src/wallet_connect/tron_connect/bundle.js"></script>
</body>
</html>
