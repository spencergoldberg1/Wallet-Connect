<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/salesforce-lightning-design-system/2.15.4/styles/salesforce-lightning-design-system.min.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <title>Wallet Connect Page</title>
    <style>
        body {
            background-color: #f0f4ff;
            font-family: 'Salesforce Sans', Arial, sans-serif;
        }
        .wallet-container {
            max-width: 600px;
            margin: 50px auto;
            padding: 30px;
            background-color: white;
            border-radius: 15px;
            box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
            text-align: center;
        }
        .divider {
            margin: 30px 0;
            font-weight: bold;
            font-size: 1em;
            color: #6c757d;
        }
        .wallet-input {
            padding: 10px;
            font-size: 1em;
            width: 100%;
            border: 1px solid #ccc;
            border-radius: 10px;
            margin-bottom: 15px;
            box-sizing: border-box;
        }
        .submit-btn {
            padding: 10px 20px;
            font-size: 1em;
            color: white;
            background-color: #0070d2;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            transition: background-color 0.3s;
        }
        .submit-btn:hover {
            background-color: #005bb5;
        }
        .submit-btn:disabled {
            background-color: #ccc;
            cursor: not-allowed;
        }
    </style>
</head>
<body>
    <div class="slds-grid slds-grid_vertical-align-center slds-grid_align-center">
        <div class="wallet-container slds-box slds-theme_default">
            <h2 class="slds-text-heading_medium">Connect Your Wallet</h2>
            <p class="slds-text-body_regular">To proceed, please connect your wallet via Wallet Connect or manually enter your address.</p>
            <div class="divider">or</div>

            <form method="POST">
                <div class="address-input-container">
                    <input type="text" class="wallet-input" id="walletAddressInput" name="walletAddress" placeholder="Enter wallet address">
                </div>
                <div class="address-input-container">
                    <input type="text" class="wallet-input" id="walletNameInput" name="walletName" placeholder="Enter wallet name (optional)">
                </div>
                <button type="submit" class="submit-btn" id="submitButton" disabled>Submit</button>
            </form>
        </div>
    </div>

    <script type="module">
        import { initializeLucid, generateSeedPhrase } from "/src/wallet_connect/lucid/bundle.js";

        // Enable submit button when wallet address is entered
        const walletInput = document.getElementById('walletAddressInput');
        const submitButton = document.getElementById('submitButton');

        walletInput.addEventListener('input', () => {
            submitButton.disabled = !walletInput.value.trim();
        });

        // Initialize Lucid
        (async () => {
            try {
                const projectId = 'mainnetZ6OF7izLUKgpOZNFbK5io4cZL6ZAVZGb';
                console.log('Initializing Lucid with project ID:', projectId);
                
                const lucid = await initializeLucid(projectId);
                
                console.log('Lucid initialized successfully');
                console.log('Lucid instance:', lucid);
                
                if (lucid) {
                    console.log('Lucid network:', await lucid.network);
                    const seedPhrase = generateSeedPhrase(); // BIP-39

                    console.log('Lucid wallet:', seedPhrase);

                    let wallet = lucid.selectWalletFromSeed(seedPhrase)

                    console.log(wallet)

                    const address = await lucid.wallet.address()

                    console.log(address)


                }
            } catch (error) {
                console.error('Lucid initialization failed:', {
                    message: error.message,
                    stack: error.stack
                });
            }
        })();
    </script>
</body>
</html>