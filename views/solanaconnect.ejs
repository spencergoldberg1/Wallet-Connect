<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/salesforce-lightning-design-system/2.15.4/styles/salesforce-lightning-design-system.min.css"
    />
    <title>Connect Your Solana Wallet</title>
    <style>
        body {
            background-color: #f0f4ff;
            font-family: 'Salesforce Sans', Arial, sans-serif;
        }
        .wallet-container {
            max-width: 600px;
            margin: 50px auto;
            padding: 30px;
            background-color: white;
            border-radius: 15px;
            box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
            text-align: center;
        }
        .wallet-buttons {
            display: flex;
            justify-content: center;
            margin-top: 20px;
        }
        .divider {
            margin: 30px 0;
            font-weight: bold;
            font-size: 1em;
            color: #6c757d;
        }
        .form-group {
            margin: 20px 0;
            text-align: left;
        }
        .wallet-input {
            width: 100%;
            padding: 10px;
            font-size: 1em;
            border: 1px solid #ccc;
            border-radius: 8px;
        }
        .submit-btn {
            margin-top: 20px;
            padding: 10px 20px;
            font-size: 1em;
            color: white;
            background-color: #0070d2;
            border: none;
            border-radius: 8px;
            cursor: pointer;
        }
        .submit-btn:hover {
            background-color: #005bb5;
        }
        .submit-btn:disabled {
            background-color: #ccc;
            cursor: not-allowed;
        }
    </style>
</head>
<body>
    <div class="slds-grid slds-grid_vertical-align-center slds-grid_align-center">
        <div class="wallet-container slds-box slds-theme_default">
            <h2 class="slds-text-heading_medium">Connect Your Solana Wallet</h2>
            <p class="slds-text-body_regular">
                Connect your Solana wallet using the wallet provider below or manually enter your wallet address.
            </p>
            <div id="wallet-buttons"></div>
            <div class="divider">or</div>
            <form id="walletForm" method="POST">
                <div class="form-group">
                    <!-- <label for="walletAddressInput" class="slds-form-element__label">Wallet Address</label> -->
                    <input
                        type="text"
                        class="wallet-input"
                        id="walletAddressInput"
                        name="walletAddress"
                        placeholder="Enter wallet address"
                    />
                </div>
                <button
                    type="submit"
                    id="submitButton"
                    class="submit-btn slds-button_brand"
                    disabled
                >
                    Submit
                </button>
            </form>
        </div>
    </div>
    <script src="/src/wallet_connect/solana_connect/bundle.js"></script>
</body>
</html>
