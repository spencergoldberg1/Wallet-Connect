# Copy to .env and fill in. Never commit .env.

# Reown / WalletConnect project ID (32 hex chars) from https://dashboard.reown.com
WALLET_CONNECT_PROJECT_ID=your_reown_project_id_here
# Optional: comma-separated EVM chain IDs to offer. Default: 1,42161,137,10,324
# Testnets available: 11155111 (Sepolia), 80002 (Polygon Amoy), 84532 (Base Sepolia)
WALLET_CONNECT_CHAIN_IDS=

# App metadata shown in wallets. APP_URL must match the origin the page is served from.
APP_NAME=Wallet Connect
APP_DESCRIPTION=Connect a wallet with WalletConnect
APP_URL=http://localhost:3000
APP_ICON_URL=

# Cardano demo page (/lucid). Use a project ID that matches CARDANO_NETWORK.
BLOCKFROST_PROJECT_ID=your_blockfrost_project_id_here
CARDANO_NETWORK=Preprod

# XRP / Xumm OAuth routes (server-side only, never sent to the browser)
BASE_URL=http://localhost:3000
XUMM_API_KEY=your_xumm_api_key_here
XUMM_API_SECRET=your_xumm_api_secret_here

PORT=3000
