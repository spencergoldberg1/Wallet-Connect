{
  "name": "wallet-connect",
  "version": "2.0.0",
  "private": true,
  "description": "Browser wallet connection via WalletConnect / Reown AppKit (EVM), plus Tron, Solana and Cardano demo pages served by Express.",
  "license": "MIT",
  "author": "Spencer Goldberg",
  "main": "./dist/lib/index.cjs",
  "module": "./dist/lib/index.mjs",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/lib/index.d.mts",
        "default": "./dist/lib/index.mjs"
      },
      "require": {
        "types": "./dist/lib/index.d.ts",
        "default": "./dist/lib/index.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/lib/utils.d.mts",
        "default": "./dist/lib/utils.mjs"
      },
      "require": {
        "types": "./dist/lib/utils.d.ts",
        "default": "./dist/lib/utils.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/lib",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "build": "npm run build:lib && npm run build:web",
    "build:lib": "tsup",
    "build:web": "webpack --mode production && node copyBundle.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "size": "node scripts/size-report.js"
  },
  "peerDependencies": {
    "@reown/appkit": "^1.8.24",
    "@reown/appkit-adapter-ethers": "^1.8.24",
    "ethers": "^6.13.0"
  },
  "dependencies": {
    "axios": "1.7.2",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "ejs": "3.1.10",
    "express": "4.19.2",
    "xumm-sdk": "1.11.1"
  },
  "devDependencies": {
    "@babel/core": "7.24.9",
    "@babel/preset-env": "7.26.0",
    "@eslint/js": "9.39.5",
    "@ledgerhq/hw-app-xrp": "6.29.0",
    "@ledgerhq/hw-transport-webhid": "6.29.0",
    "@ledgerhq/hw-transport-webusb": "6.29.0",
    "@ledgerhq/logs": "6.12.0",
    "@reown/appkit": "1.8.24",
    "@reown/appkit-adapter-ethers": "1.8.24",
    "@solana/wallet-adapter-base": "0.9.23",
    "@solana/wallet-adapter-react": "0.15.35",
    "@solana/wallet-adapter-react-ui": "0.9.35",
    "@solana/wallet-adapter-wallets": "0.19.32",
    "@solana/web3.js": "1.98.0",
    "@tronweb3/tronwallet-abstract-adapter": "1.1.7",
    "@tronweb3/tronwallet-adapters": "1.2.4",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "babel-loader": "9.2.1",
    "browserify-zlib": "0.2.0",
    "buffer": "6.0.3",
    "crypto-browserify": "3.12.1",
    "css-loader": "7.1.2",
    "eslint": "9.39.5",
    "ethers": "6.17.0",
    "globals": "16.5.0",
    "https-browserify": "1.0.0",
    "lucid-cardano": "0.10.11",
    "nodemon": "3.1.14",
    "os-browserify": "0.3.0",
    "path-browserify": "1.0.1",
    "process": "0.11.10",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "stream-browserify": "3.0.0",
    "stream-http": "3.2.0",
    "style-loader": "4.0.0",
    "ts-loader": "9.5.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "url": "0.11.4",
    "vitest": "4.1.11",
    "vm-browserify": "1.1.2",
    "webpack": "5.93.0",
    "webpack-cli": "5.1.4"
  }
}
